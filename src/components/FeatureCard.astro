---
/**
 * 首页精选（置顶）文章大卡片
 */
import Icon from './Icon.astro';
import type { Post } from '../utils/posts';
import { postUrl, readingTime } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const reading = readingTime(post);
---

<a href={postUrl(post)} class="feature reveal">
  <div class="f-badge" aria-hidden="true">
    <span class="v-text">置顶</span>
  </div>
  <div class="f-body">
    <div class="f-kicker">
      <Icon name="sparkle" size={14} />
      <span>精选文章</span>
      {post.data.series && <span class="dot-sep"></span>}
      {post.data.series && <span>{post.data.series}</span>}
    </div>
    <h2 class="f-title">{post.data.title}</h2>
    {post.data.description && <p class="f-desc">{post.data.description}</p>}
    <div class="f-meta">
      <span class="meta-item">
        <Icon name="calendar" size={14} />
        {post.data.date.getFullYear()} 年 {post.data.date.getMonth() + 1} 月 {post.data.date.getDate()} 日
      </span>
      <span class="meta-item">
        <Icon name="clock" size={14} /> 约 {reading} 分钟
      </span>
      <span class="f-cta">阅读全文 <Icon name="arrow-right" size={15} /></span>
    </div>
  </div>
</a>

<style>
  .feature {
    position: relative;
    display: block;
    border: 1px solid var(--line2);
    border-radius: var(--r-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, var(--wash) 0%, transparent 55%),
      radial-gradient(90% 120% at 0% 100%, color-mix(in srgb, var(--gold) 12%, transparent) 0%, transparent 50%),
      var(--bg1);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: transform 0.35s var(--ease-spring), box-shadow 0.35s, border-color 0.35s;
  }

  .feature:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), var(--glow);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line2));
  }

  .f-badge {
    position: absolute;
    right: 1.4rem;
    top: 1.4rem;
    display: grid;
    place-items: center;
    width: 2.1rem;
    padding: 1rem 0;
    border-radius: 8px;
    background: linear-gradient(160deg, #c8441f, #a02c10);
    color: #fff6e8;
    font-size: 0.95rem;
    box-shadow: var(--shadow-sm);
    transform: rotate(4deg);
    transition: transform 0.35s var(--ease-spring);
  }

  .feature:hover .f-badge {
    transform: rotate(-3deg) scale(1.06);
  }

  .f-body {
    padding: 2rem 2.2rem;
    max-width: 54rem;
  }

  .f-kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    color: var(--accent-ink);
    font-weight: 600;
  }

  .f-title {
    font-size: clamp(1.45rem, 3.2vw, 2rem);
    margin: 0.7rem 0 0.65rem;
    transition: color 0.25s;
  }

  .feature:hover .f-title {
    color: var(--accent-ink);
  }

  .f-desc {
    margin: 0;
    color: var(--ink2);
    font-size: 0.95rem;
    line-height: 1.85;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .f-meta {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-wrap: wrap;
    margin-top: 1.3rem;
    font-size: 0.82rem;
    color: var(--ink3);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .f-cta {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--accent-ink);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .feature:hover .f-cta :global(svg) {
    animation: nudge 0.5s var(--ease-out) infinite alternate;
  }

  @keyframes nudge {
    to {
      transform: translateX(4px);
    }
  }

  @media (max-width: 640px) {
    .f-body {
      padding: 1.5rem 1.4rem;
    }

    .f-badge {
      right: 1rem;
      top: 1.1rem;
    }
  }
</style>

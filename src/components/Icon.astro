---
/**
 * 内联 SVG 图标组件：图标统一放在 utils/icons.ts，
 * 组件侧与服务端渲染共用同一份（客户端脚本也直接 import 该模块拼 innerHTML）
 */
import { ICONS, type IconName } from '../utils/icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<span class:list={['icon', className]} set:html={ICONS[name] ?? ''} />

<style>
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1em;
    line-height: 1;
    flex: none;
  }

  .icon :global(svg) {
    display: block;
    font-size: inherit;
  }
</style>

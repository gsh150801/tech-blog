  rss: `<svg ${S} width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 5.5a14 14 0 0 1 14 14M4.5 11.2a8.3 8.3 0 0 1 8.3 8.3"/><circle cx="5.6" cy="18.4" r="1.7" fill="currentColor" stroke="none"/></svg>`,
  mail: `<svg ${S} width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4.5 7.5 7.5 6 7.5-6"/></svg>`,
  external: `<svg ${S} width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4 11 13M9 5.5H6a2 2 0 0 0-2 2V18a2 2 0 0 0 2 2h10.5a2 2 0 0 0 2-2v-3"/></svg>`,
  sparkle: `<svg ${S} width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 13.8 9l5.7 1.8-5.7 1.8L12 18.2l-1.8-5.6L4.5 10.8 10.2 9 12 3.5Z"/><path d="M19 15.5l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6Z"/></svg>`,
  pen: `<svg ${S} width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5 4.5 4.5L8 20.5l-5 1 1-5L14.5 5Z"/><path d="m12.5 7 4.5 4.5"/></svg>`,
} as const;
---

<span class:list={['icon', className]} set:html={ICONS[name] ?? ''} />

<style>
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1em;
    line-height: 1;
    flex: none;
  }

  .icon :global(svg) {
    display: block;
    font-size: inherit;
  }
</style>

---
/**
 * 朱砂印章 Logo：手绘感的圆角方印 + 「拾」字
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 40, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="拾集印章"
>
  <defs>
    <linearGradient id="seal-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#c8441f"></stop>
      <stop offset="1" stop-color="#a02c10"></stop>
    </linearGradient>
  </defs>
  <rect x="3" y="3" width="58" height="58" rx="14" fill="url(#seal-bg)"></rect>
  <rect
    x="7.5"
    y="7.5"
    width="49"
    height="49"
    rx="10"
    fill="none"
    stroke="#fff3e4"
    stroke-width="1.6"
    opacity="0.55"></rect>
  <text
    x="32"
    y="33"
    text-anchor="middle"
    dominant-baseline="central"
    font-family="'Songti SC','Noto Serif SC','STSong',serif"
    font-size="30"
    font-weight="700"
    fill="#fff6e8">拾</text>
  <circle cx="47" cy="47" r="2.2" fill="#fff3e4" opacity="0.7"></circle>
</svg>

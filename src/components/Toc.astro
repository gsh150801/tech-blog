---
/**
 * 文章目录（桌面端侧栏显示，滚动高亮当前小节）
 */
import Icon from './Icon.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{
  toc.length >= 2 && (
    <nav class="toc" aria-label="本文目录">
      <div class="toc-head">
        <Icon name="pen" size={14} />
        <span>本文目录</span>
      </div>
      <ul>
        {toc.map((h) => (
          <li class:list={['toc-item', `d${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
    width: 15rem;
    max-height: calc(100dvh - var(--header-h) - 5rem);
    overflow-y: auto;
    padding: 1rem 0 1rem 1.1rem;
    border-left: 2px solid var(--line);
    font-size: 0.84rem;
    scrollbar-width: none;
  }

  .toc::-webkit-scrollbar {
    display: none;
  }

  .toc-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink3);
    font-size: 0.74rem;
    letter-spacing: 0.22em;
    font-weight: 600;
    margin-bottom: 0.7rem;
  }

  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    position: relative;
  }

  .toc-item a {
    display: block;
    padding: 0.28rem 0.7rem 0.28rem 0.95rem;
    color: var(--ink3);
    line-height: 1.55;
    border-left: 2px solid transparent;
    margin-left: -2px;
    transition: color 0.2s, border-color 0.2s;
  }

  .toc-item.d3 {
    padding-left: 1rem;
  }

  .toc-item.d3 a {
    font-size: 0.92em;
    padding-left: 1.5rem;
  }

  .toc-item a:hover {
    color: var(--ink);
  }

  .toc-item.active > a {
    color: var(--accent-ink);
    border-left-color: var(--accent);
    font-weight: 600;
  }
</style>

<script>
  const spy = () => {
    const items = [...document.querySelectorAll<HTMLAnchorElement>('.toc-item > a')];
    if (!items.length) return;
    const heads = items
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((el): el is HTMLElement => !!el);

    const onScroll = () => {
      const y = window.scrollY + 120;
      let current = -1;
      heads.forEach((h, i) => {
        if (h.offsetTop <= y) current = i;
      });
      items.forEach((a, i) => a.parentElement?.classList.toggle('active', i === current));
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  };

  document.addEventListener('astro:page-load', spy);
</script>

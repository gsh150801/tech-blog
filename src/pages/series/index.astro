---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SITE, SERIES_META } from '../../config';
import { withBase } from '../../utils/path';
import { getAllPosts, getSeries, cnVolume, seriesSlug } from '../../utils/posts';

const posts = await getAllPosts();
const series = [...getSeries(posts).entries()].map(([name, list]) => {
  // 优先用系列内显式声明的 seriesSlug（ASCII），否则用 %xx 编码
  const explicit = list.find((p) => p.data.seriesSlug)?.data.seriesSlug;
  return { name, list, slug: seriesSlug(name, explicit) };
});
---

<Base title="合集" description="按主题整理的系列文章合集，适合系统性地阅读与分享。">
  <div class="container">
    <header class="page-head reveal">
      <h1 class="page-title">合集书架</h1>
      <p class="page-desc">
        教程与笔记按主题装订成卷 —— 每一卷都有独立链接，方便一次分享整个系列。
      </p>
    </header>

    <div class="series-list">
      {
        series.map(({ name, list, slug }, i) => (
          <a
            class="s-card reveal"
            href={withBase(`/series/${slug}/`)}
            style={`--rd:${Math.min(i, 5) * 0.06}s`}
          >
            <div class="s-vol" aria-hidden="true">
              <span class="v-text">卷{cnVolume(i + 1)}</span>
            </div>
            <div class="s-body">
              <h2 class="s-name">{name}</h2>
              <p class="s-desc">{SERIES_META[name]?.description ?? '一个持续更新的主题合集。'}</p>
              <div class="s-meta">
                <span>{list.length} 篇</span>
                <span class="dot-sep" />
                <span>
                  最近更新 {list[list.length - 1].data.date.getFullYear()} 年
                  {list[list.length - 1].data.date.getMonth() + 1} 月
                </span>
              </div>
            </div>
            <span class="s-arrow">
              <Icon name="arrow-right" size={20} />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .page-head {
    padding: 3.2rem 0 2.4rem;
  }

  .page-title {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .page-title::before {
    content: '';
    width: 1.3rem;
    height: 0.6rem;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--accent), var(--gold));
    transform: skewX(-12deg);
  }

  .page-desc {
    margin: 0.7rem 0 0;
    color: var(--ink3);
    max-width: 38rem;
    line-height: 1.8;
  }

  .series-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .s-card {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding: 1.6rem 1.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg1);
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s, border-color 0.3s;
  }

  .s-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line2));
    box-shadow: var(--shadow-md);
  }

  .s-vol {
    flex: none;
    display: grid;
    place-items: center;
    padding: 1.1rem 0.5rem;
    border: 1.5px solid color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--accent-ink);
    font-size: 0.95rem;
    transform: rotate(3deg);
    transition: transform 0.3s var(--ease-spring);
  }

  .s-card:hover .s-vol {
    transform: rotate(-3deg) scale(1.05);
  }

  .s-body {
    flex: 1;
    min-width: 0;
  }

  .s-name {
    font-size: 1.25rem;
    margin: 0;
    transition: color 0.2s;
  }

  .s-card:hover .s-name {
    color: var(--accent-ink);
  }

  .s-desc {
    margin: 0.45rem 0 0.6rem;
    font-size: 0.88rem;
    color: var(--ink2);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .s-meta {
    display: flex;
    align-items: center;
    font-size: 0.76rem;
    color: var(--ink3);
    letter-spacing: 0.05em;
  }

  .s-arrow {
    flex: none;
    color: var(--ink3);
    transition: color 0.25s, transform 0.25s var(--ease-out);
  }

  .s-card:hover .s-arrow {
    color: var(--accent);
    transform: translateX(5px);
  }

  @media (max-width: 560px) {
    .s-card {
      padding: 1.2rem 1.2rem;
      gap: 1rem;
    }

    .s-arrow {
      display: none;
    }
  }
</style>

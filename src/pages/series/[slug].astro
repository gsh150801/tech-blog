---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostRow from '../../components/PostRow.astro';
import { SITE, SERIES_META } from '../../config';
import { cnVolume } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const groups = new Map<string, { slug: string; idx: number }>();
  for (const [idx, p] of posts.entries()) {
    if (!p.data.series) continue;
    const slug = p.data.seriesSlug ?? encodeURIComponent(p.data.series);
    if (!groups.has(p.data.series)) groups.set(p.data.series, { slug, idx });
  }
  let vol = 0;
  return [...groups.entries()].map(([name, { slug }]) => ({
    params: { slug },
    props: { name, slug, volume: ++vol },
  }));
}

const { name, slug, volume } = Astro.props;
const all = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((p) => (p.data.seriesSlug ?? encodeURIComponent(p.data.series ?? '')) === slug)
  .sort((a, b) => {
    const oa = a.data.seriesOrder ?? Number.MAX_SAFE_INTEGER;
    const ob = b.data.seriesOrder ?? Number.MAX_SAFE_INTEGER;
    return oa !== ob ? oa - ob : a.data.date.valueOf() - b.data.date.valueOf();
  });

const desc = SERIES_META[name]?.description;
---

<Base title={name} description={desc ?? `${name} 合集，共 ${all.length} 篇文章。`}>
  <div class="container">
    <header class="page-head reveal">
      <div class="vol-badge" aria-hidden="true">
        <span class="v-text">卷{cnVolume(volume)}</span>
      </div>
      <div class="head-text">
        <p class="head-kicker">合集</p>
        <h1 class="page-title">{name}</h1>
        {
          desc && (
            <p class="page-desc">{desc}</p>
          )
        }
        <div class="head-meta">
          <span>共 {all.length} 篇</span>
          <button class="share-btn" data-share type="button">
            <Icon name="share" size={14} />
            <span class="share-label">分享整个合集</span>
          </button>
        </div>
      </div>
    </header>

    <div class="post-list">
      {all.map((p, i) => <PostRow post={p} order={i + 1} showSeries={false} style={`--rd:${Math.min(i, 5) * 0.05}s`} />)}
    </div>
  </div>
</Base>

<style>
  .page-head {
    display: flex;
    gap: 1.8rem;
    align-items: flex-start;
    padding: 3rem 0 2.6rem;
  }

  .vol-badge {
    flex: none;
    display: grid;
    place-items: center;
    padding: 1.6rem 0.7rem;
    border: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent-ink);
    font-size: 1.15rem;
    box-shadow: var(--shadow-sm);
    transform: rotate(3deg);
    margin-top: 0.4rem;
  }

  .head-kicker {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.35em;
    color: var(--ink3);
    font-weight: 600;
  }

  .page-title {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    margin: 0.5rem 0 0;
  }

  .page-desc {
    margin: 0.8rem 0 0;
    color: var(--ink2);
    max-width: 40rem;
    line-height: 1.85;
  }

  .head-meta {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.2rem;
    font-size: 0.84rem;
    color: var(--ink3);
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.4em 1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink2);
    transition: border-color 0.2s, color 0.2s, background-color 0.2s, transform 0.2s var(--ease-spring);
  }

  .share-btn:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
    background: var(--wash);
    transform: translateY(-1px);
  }

  @media (max-width: 560px) {
    .page-head {
      flex-direction: column;
      gap: 1rem;
    }

    .vol-badge {
      padding: 1rem 0.55rem;
      font-size: 0.9rem;
    }
  }
</style>

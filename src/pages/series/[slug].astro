---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PostRow from '../../components/PostRow.astro';
import { withBase } from '../../utils/path';
import { getAllPosts, resolveSeries, cnVolume } from '../../utils/posts';

const allPosts = await getAllPosts();
const series = resolveSeries(allPosts);

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const entries = resolveSeries(posts);
  return entries.map((s, i) => ({
    params: { slug: s.slug },
    props: { name: s.name, description: s.description, volume: i + 1 },
  }));
}

const { name, description, volume } = Astro.props;
const entry = series.find((s) => s.name === name);
const all = entry?.posts ?? [];
---

<Base title={name} description={description ?? `${name} 合集，共 ${all.length} 篇文章。`}>
  <div class="container">
    <header class="page-head reveal">
      <div class="vol-badge" aria-hidden="true">
        <span class="v-text">卷{cnVolume(volume)}</span>
      </div>
      <div class="head-text">
        <p class="head-kicker">合集</p>
        <h1 class="page-title">{name}</h1>
        {
          description && (
            <p class="page-desc">{description}</p>
          )
        }
        <div class="head-meta">
          <span>共 {all.length} 篇</span>
          <button class="share-btn" data-share type="button">
            <Icon name="share" size={14} />
            <span class="share-label">分享整个合集</span>
          </button>
        </div>
      </div>
    </header>

    {
      all.length > 0 ? (
        <div class="post-list">
          {all.map((p, i) => (
            <PostRow post={p} order={i + 1} showSeries={false} style={`--rd:${Math.min(i, 5) * 0.05}s`} />
          ))}
        </div>
      ) : (
        <div class="empty-state reveal">
          <Icon name="folder" size={28} />
          <p>这一卷已经建好，第一篇文章还在路上。</p>
          <a class="btn" href={withBase('/posts/editor/')}>
            <Icon name="pen" size={15} /> 去写第一篇
          </a>
        </div>
      )
    }
  </div>
</Base>

<style>
  .page-head {
    display: flex;
    gap: 1.8rem;
    align-items: flex-start;
    padding: 3rem 0 2.6rem;
  }

  .vol-badge {
    flex: none;
    display: grid;
    place-items: center;
    padding: 1.6rem 0.7rem;
    border: 2px solid color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent-ink);
    font-size: 1.15rem;
    box-shadow: var(--shadow-sm);
    transform: rotate(3deg);
    margin-top: 0.4rem;
  }

  .head-kicker {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.35em;
    color: var(--ink3);
    font-weight: 600;
  }

  .page-title {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    margin: 0.5rem 0 0;
  }

  .page-desc {
    margin: 0.8rem 0 0;
    color: var(--ink2);
    max-width: 40rem;
    line-height: 1.85;
  }

  .head-meta {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 1.2rem;
    font-size: 0.84rem;
    color: var(--ink3);
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.4em 1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink2);
    transition: border-color 0.2s, color 0.2s, background-color 0.2s, transform 0.2s var(--ease-spring);
  }

  .share-btn:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
    background: var(--wash);
    transform: translateY(-1px);
  }

  @media (max-width: 560px) {
    .page-head {
      flex-direction: column;
      gap: 1rem;
    }

    .vol-badge {
      padding: 1rem 0.55rem;
      font-size: 0.9rem;
    }
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 4rem 1.5rem;
    border: 1px dashed var(--line2);
    border-radius: var(--r-lg);
    color: var(--ink3);
    text-align: center;
  }

  .empty-state p {
    margin: 0;
    color: var(--ink2);
  }
</style>

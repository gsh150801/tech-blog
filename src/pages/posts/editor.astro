---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config';

const today = new Date().toISOString().slice(0, 10);

const seed = `---
title: 
date: ${today}
tags: []
draft: true
---

在这里开始写。

# 一级标题

支持 **加粗**、*斜体*、\`行内代码\`、~~删除线~~、[链接](https://astro.build)。

数学公式（KaTeX）：

$$
e^{i\\pi} + 1 = 0
$$

行内公式 $a^2 + b^2 = c^2$。

表格：

| 列 A | 列 B |
| ---- | ---- |
| 1    | 2    |

任务列表：

- [x] 已完成
- [ ] 待办

代码块：

\`\`\`ts
function hello(name: string) {
  return \`Hi, \${name}\`;
}
\`\`\`

> 引用块也很友好

\`\`\`
`;
---

<Base
  title="在线编辑器"
  description="带 LaTeX / 表格 / 拖拽图片的 Markdown 在线编辑器，所见即所得。保存到 GitHub 直接发布。"
  noindex
>
  <div class="editor-shell">
    <header class="ed-bar" id="ed-bar">
      <div class="ed-bar-left">
        <a href="/" class="ed-logo">
          <Icon name="arrow-left" size={16} /> 拾集
        </a>
        <span class="ed-divider" aria-hidden="true">/</span>
        <input
          id="ed-filename"
          class="ed-filename"
          type="text"
          value="my-new-post.md"
          spellcheck="false"
        />
        <span class="ed-status" id="ed-status">未保存</span>
      </div>

      <div class="ed-bar-right">
        <button class="ed-btn" id="ed-toggle" type="button" aria-label="切换预览">
          <Icon name="sparkle" size={15} /> 预览
        </button>
        <button class="ed-btn ed-btn-a" id="ed-appearance" type="button" aria-label="调节编辑区外观" aria-haspopup="true">
          Aa
        </button>
        <button class="ed-btn" id="ed-settings" type="button" aria-label="设置">
          <Icon name="external" size={14} /> GitHub 凭据
        </button>
        <button class="ed-btn ed-primary" id="ed-save" type="button">
          <Icon name="check" size={15} /> 保存到 GitHub
        </button>
      </div>
    </header>

    <div class="ed-grid">
      <section class="ed-pane ed-edit" aria-label="编辑器">
        <div class="ed-toolbar" role="toolbar" aria-label="格式化工具">
          <button type="button" data-act="h1" title="一级标题">H1</button>
          <button type="button" data-act="h2" title="二级标题">H2</button>
          <button type="button" data-act="h3" title="三级标题">H3</button>
          <span class="ed-tb-sep" aria-hidden="true"></span>
          <button type="button" data-act="bold" title="加粗"><strong>B</strong></button>
          <button type="button" data-act="italic" title="斜体"><em>I</em></button>
          <button type="button" data-act="strike" title="删除线"><s>S</s></button>
          <button type="button" data-act="code" title="行内代码"><code>&lt;/&gt;</code></button>
          <span class="ed-tb-sep" aria-hidden="true"></span>
          <button type="button" data-act="link" title="插入链接"><Icon name="external" size={13} /></button>
          <button type="button" data-act="image" title="插入/上传图片"><Icon name="sparkle" size={13} /></button>
          <button type="button" data-act="video" title="插入/上传视频">▶</button>
          <button type="button" data-act="table" title="插入表格"><Icon name="folder" size={13} /></button>
          <button type="button" data-act="math" title="插入 LaTeX 公式">∑</button>
          <button type="button" data-act="math-block" title="插入公式块">∫</button>
          <button type="button" data-act="task" title="任务列表"><Icon name="check" size={13} /></button>
          <button type="button" data-act="quote" title="引用">&gt;</button>
          <button type="button" data-act="codeblock" title="代码块">{ }</button>
          <span class="ed-tb-sep" aria-hidden="true"></span>
          <button type="button" data-act="ul" title="无序列表">•</button>
          <button type="button" data-act="ol" title="有序列表">1.</button>
          <span class="ed-tb-sep" aria-hidden="true"></span>
          <button type="button" data-act="undo" title="撤销"><Icon name="arrow-left" size={13} /></button>
          <button type="button" data-act="redo" title="重做"><Icon name="arrow-right" size={13} /></button>
        </div>

        <textarea
          id="ed-textarea"
          class="ed-textarea"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          autocorrect="off"
        >{seed}</textarea>

        <input id="ed-image-input" type="file" accept="image/*" hidden />
        <input id="ed-video-input" type="file" accept="video/*" hidden />
      </section>

      <section class="ed-pane ed-preview" aria-label="实时预览">
        <div id="ed-preview" class="ed-preview-body prose"></div>
      </section>
    </div>

    <dialog id="ed-settings-dlg" class="ed-dialog">
      <div class="ed-dlg-box">
        <header class="ed-dlg-head">
          <h2>GitHub 凭据</h2>
          <button class="ed-icon" type="button" data-close><Icon name="close" size={16} /></button>
        </header>
        <p class="ed-dlg-desc">
          保存文章需要一个有 <code>repo</code> 权限的 GitHub Personal Access Token。
          Token 仅保存在你的浏览器（localStorage），不会被发送到任何后端。
          <a href="https://github.com/settings/tokens?type=beta" target="_blank" rel="noopener noreferrer">
            去申请 <Icon name="external" size={12} />
          </a>
        </p>
        <label class="ed-dlg-field">
          <span>仓库</span>
          <input id="ed-repo" type="text" value={SITE.repo} />
        </label>
        <label class="ed-dlg-field">
          <span>分支</span>
          <input id="ed-branch" type="text" value="main" />
        </label>
        <label class="ed-dlg-field">
          <span>Personal Access Token</span>
          <input id="ed-token" type="password" placeholder="ghp_…" autocomplete="off" />
        </label>
        <div class="ed-dlg-actions">
          <button class="ed-btn" type="button" data-close>取消</button>
          <button class="ed-btn ed-primary" id="ed-save-token" type="button">保存</button>
        </div>
      </div>
    </dialog>

    <div class="ed-pop" id="ed-appearance-pop" role="menu" aria-label="编辑区外观" hidden>
      <div class="ed-pop-group">
        <div class="ed-pop-label">编辑区主题</div>
        <div class="ed-pop-options">
          <button type="button" class="ed-opt" data-set="theme" data-val="paper">
            <span class="swatch swatch-paper"></span>宣纸
          </button>
          <button type="button" class="ed-opt" data-set="theme" data-val="dark">
            <span class="swatch swatch-dark"></span>深墨
          </button>
        </div>
      </div>
      <div class="ed-pop-group">
        <div class="ed-pop-label">正文字号</div>
        <div class="ed-pop-options">
          <button type="button" class="ed-opt" data-set="size" data-val="s"><span class="fs fs-s">小</span></button>
          <button type="button" class="ed-opt" data-set="size" data-val="m"><span class="fs fs-m">中</span></button>
          <button type="button" class="ed-opt" data-set="size" data-val="l"><span class="fs fs-l">大</span></button>
        </div>
      </div>
      <div class="ed-pop-group">
        <div class="ed-pop-label">编辑区字体</div>
        <div class="ed-pop-options">
          <button type="button" class="ed-opt" data-set="font" data-val="sans">无衬线</button>
          <button type="button" class="ed-opt" data-set="font" data-val="serif"><span class="fs-serif">衬线</span></button>
        </div>
      </div>
      <div class="ed-pop-tip">选择自动记住，预览区始终跟随站点纸墨主题。</div>
    </div>

    <div class="ed-toast" id="ed-toast" role="status" aria-live="polite" hidden></div>
  </div>
</Base>

<style is:global>
  /* 编辑器是全屏工作区：隐藏站点外壳（本样式表仅在本页面引入） */
  .site-header,
  .footer,
  .back-top {
    display: none !important;
  }

  body {
    overflow: hidden;
  }

  body::after {
    display: none !important;
  }

  /* 编辑器专用深色布局，脱离 paper主题 */
  .editor-shell {
    --bg: #1a1612;
    --panel: #221c14;
    --line: #2e2519;
    --ink: #ece2cd;
    --ink2: #b2a68d;
    --ink3: #827763;
    --accent: #ff7448;
    --accent-deep: #ff8f6b;
    --wash: #2e2014;
    --ed-fs: 0.95rem;
    --ed-font: 'SF Mono', 'JetBrains Mono', 'Fira Code', ui-monospace, Menlo, Consolas, monospace;

    position: fixed;
    inset: 0;
    background: var(--bg);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    z-index: 200;
  }

  /* 外观档位：字号 */
  .editor-shell[data-ed-size='s'] { --ed-fs: 0.85rem; }
  .editor-shell[data-ed-size='m'] { --ed-fs: 0.95rem; }
  .editor-shell[data-ed-size='l'] { --ed-fs: 1.08rem; }

  /* 外观档位：字体（衬线更接近读书感，适合长文写作） */
  .editor-shell[data-ed-font='serif'] {
    --ed-font: 'Songti SC', 'Noto Serif SC', Georgia, 'Times New Roman', serif;
  }

  /* 外观主题：宣纸（浅色，与站点预览区一致） */
  .editor-shell[data-ed-theme='paper'] {
    --bg: #fbf7ec;
    --panel: #f5efe2;
    --line: #e3dac4;
    --ink: #27211a;
    --ink2: #665d4c;
    --ink3: #9a917c;
    --accent: #b93a1a;
    --accent-deep: #96290d;
    --wash: #f4e3d6;
  }

  .editor-shell[data-ed-theme='paper'] .ed-textarea::selection {
    background: rgba(185, 58, 26, 0.22);
  }

  .editor-shell header.ed-bar {
    flex: none;
    height: 3.4rem;
    padding: 0 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
  }

  .ed-bar-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex: 1;
    min-width: 0;
  }

  .ed-bar-right {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
  }

  .ed-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink2);
    padding: 0.35rem 0.7rem;
    border-radius: 8px;
    transition: background-color 0.2s, color 0.2s;
    text-decoration: none;
  }

  .ed-logo:hover {
    background: var(--wash);
    color: var(--accent);
  }

  .ed-divider {
    color: var(--ink3);
  }

  .ed-filename {
    flex: 1;
    min-width: 12rem;
    max-width: 22rem;
    background: transparent;
    border: 1px solid transparent;
    color: var(--ink);
    padding: 0.42rem 0.65rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .ed-filename:hover {
    border-color: var(--line);
  }

  .ed-filename:focus {
    border-color: var(--accent);
    outline: none;
    background: var(--bg);
  }

  .ed-status {
    flex: none;
    font-size: 0.76rem;
    color: var(--ink3);
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    white-space: nowrap;
  }

  .ed-status.dirty {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
  }

  .ed-status.saved {
    color: #7fb0a7;
    border-color: color-mix(in srgb, #7fb0a7 40%, var(--line));
  }

  .ed-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    height: 2.15rem;
    padding: 0 0.85rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink2);
    font-size: 0.84rem;
    transition: border-color 0.2s, color 0.2s, background-color 0.2s, transform 0.2s var(--ease-spring);
  }

  .ed-btn:hover {
    border-color: var(--ink3);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .ed-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff6e8;
    font-weight: 600;
  }

  .ed-primary:hover {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    color: #fff6e8;
    box-shadow: 0 4px 14px -3px color-mix(in srgb, var(--accent) 50%, transparent);
  }

  .ed-btn-a {
    font-family: 'Fraunces', 'Songti SC', serif;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0 0.7rem;
  }

  /* 外观弹层 */
  .ed-pop {
    position: fixed;
    top: 3.7rem;
    right: 1rem;
    z-index: 210;
    width: 15.5rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.9rem 1rem 0.7rem;
    box-shadow: 0 16px 44px -10px rgba(0, 0, 0, 0.45);
    animation: ed-pop-in 0.22s var(--ease-out);
  }

  @keyframes ed-pop-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  .ed-pop-group {
    margin-bottom: 0.8rem;
  }

  .ed-pop-label {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--ink3);
    margin-bottom: 0.4rem;
  }

  .ed-pop-options {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .ed-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.38em 0.8em;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink2);
    font-size: 0.82rem;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s, transform 0.15s var(--ease-spring);
  }

  .ed-opt:hover {
    border-color: var(--ink3);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .ed-opt.active {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    font-weight: 600;
  }

  .swatch {
    width: 0.85em;
    height: 0.85em;
    border-radius: 4px;
    border: 1px solid var(--line);
    flex: none;
  }

  .swatch-paper {
    background: #fbf7ec;
  }

  .swatch-dark {
    background: #1a1612;
  }

  .fs-serif {
    font-family: 'Songti SC', 'Noto Serif SC', Georgia, serif;
  }

  .fs-s { font-size: 0.72em; }
  .fs-m { font-size: 0.86em; }
  .fs-l { font-size: 1em; }

  .ed-pop-tip {
    font-size: 0.72rem;
    color: var(--ink3);
    border-top: 1px dashed var(--line);
    padding-top: 0.6rem;
    line-height: 1.6;
  }

  .ed-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    color: var(--ink2);
    background: transparent;
    border: 0;
    transition: color 0.2s, background-color 0.2s;
  }

  .ed-icon:hover {
    color: var(--ink);
    background: var(--wash);
  }

  /* 主网格 */
  .ed-grid {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .editor-shell.preview-only .ed-edit {
    display: none;
  }

  .editor-shell.edit-only .ed-preview {
    display: none;
  }

  .editor-shell.preview-only .ed-grid {
    grid-template-columns: 1fr;
  }

  .editor-shell.edit-only .ed-grid {
    grid-template-columns: 1fr;
  }

  .ed-pane {
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .ed-edit {
    border-right: 1px solid var(--line);
    background: var(--bg);
  }

  .ed-preview {
    background: #fbf7ec;
    color: #27211a;
    overflow-y: auto;
  }

  [data-theme='dark'] .ed-preview,
  .editor-shell[data-theme='dark'] .ed-preview {
    background: #1a1610;
    color: #ece2cd;
  }

  /* 工具栏 */
  .ed-toolbar {
    flex: none;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.15rem;
    padding: 0.5rem 0.7rem;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }

  .ed-toolbar button {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.5rem;
    border-radius: 6px;
    color: var(--ink2);
    background: transparent;
    border: 0;
    font-size: 0.86rem;
    font-family: var(--font-mono);
    transition: background-color 0.15s, color 0.15s, transform 0.15s;
  }

  .ed-toolbar button:hover {
    background: var(--wash);
    color: var(--ink);
  }

  .ed-toolbar button strong,
  .ed-toolbar button em,
  .ed-toolbar button s,
  .ed-toolbar button code {
    font-size: 0.86rem;
  }

  .ed-toolbar button:active {
    transform: scale(0.95);
  }

  .ed-tb-sep {
    width: 1px;
    height: 1.2rem;
    background: var(--line);
    margin: 0 0.25rem;
  }

  /* 文本编辑区 */
  .ed-textarea {
    flex: 1;
    min-height: 0;
    width: 100%;
    border: 0;
    outline: none;
    resize: none;
    padding: 1.2rem 1.5rem;
    background: transparent;
    color: var(--ink);
    font-family: var(--ed-font);
    font-size: var(--ed-fs);
    line-height: 1.85;
    tab-size: 2;
    caret-color: var(--accent);
    transition: color 0.25s, background-color 0.25s;
  }

  .ed-textarea::placeholder {
    color: var(--ink3);
  }

  /* 预览区 */
  .ed-preview-body {
    flex: 1;
    padding: 1.6rem 2rem 4rem;
    max-width: 44rem;
    margin-inline: auto;
    font-size: 1.02rem;
    line-height: 1.95;
  }

  .ed-preview-body :where(h1, h2, h3) {
    font-family: 'Fraunces', 'Songti SC', 'Noto Serif SC', serif;
    margin-block: 1.6em 0.6em;
  }

  .ed-preview-body h1 {
    font-size: 1.9rem;
  }

  .ed-preview-body h2 {
    font-size: 1.5rem;
    border-bottom: 1px solid #e3dac4;
    padding-bottom: 0.35em;
  }

  .ed-preview-body h3 {
    font-size: 1.2rem;
  }

  .ed-preview-body p {
    margin-block: 0.85em;
  }

  .ed-preview-body blockquote {
    margin: 1.4em 0;
    padding: 0.7em 1.2em;
    border-left: 3px solid var(--accent);
    background: rgba(185, 58, 26, 0.07);
    color: var(--ink2);
    border-radius: 0 6px 6px 0;
  }

  .ed-preview-body code:not(pre code) {
    background: rgba(185, 58, 26, 0.1);
    color: var(--accent-deep);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.86em;
  }

  .ed-preview-body pre {
    background: #fbf7ec;
    color: #27211a;
    padding: 0.9rem 1.1rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.88rem;
  }

  [data-theme='dark'] .ed-preview-body pre,
  .editor-shell .ed-preview-body pre {
    background: #16120d;
    color: #ece2cd;
  }

  .ed-preview-body table {
    border-collapse: collapse;
    width: 100%;
    margin: 1em 0;
    font-size: 0.92em;
  }

  .ed-preview-body th,
  .ed-preview-body td {
    border: 1px solid #e3dac4;
    padding: 0.5em 0.9em;
  }

  .ed-preview-body th {
    background: rgba(185, 58, 26, 0.06);
    font-family: 'Fraunces', serif;
    font-weight: 640;
  }

  .ed-preview-body ul li::marker {
    color: var(--accent);
  }

  .ed-preview-body :is(ul, ol) li > input[type='checkbox'] {
    accent-color: var(--accent);
    margin-right: 0.4em;
    transform: translateY(0.1em);
  }

  .ed-preview-body img {
    max-width: 100%;
    border-radius: 8px;
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.18);
  }

  .ed-preview-body video {
    max-width: 100%;
    border-radius: 8px;
    background: #000;
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.18);
    display: block;
    margin: 1em auto;
  }

  .ed-preview-body hr {
    border: 0;
    text-align: center;
    margin: 2em 0;
  }

  .ed-preview-body hr::after {
    content: '· · ·';
    letter-spacing: 1.4em;
    color: var(--ink3);
  }

  .ed-preview-body .katex-display {
    margin: 1.4em 0;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .ed-preview-body .katex {
    font-size: 1.05em;
  }

  .ed-preview-body .math-inline,
  .ed-preview-body .math-block {

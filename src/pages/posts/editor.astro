</style>

<script>
  // ============================================================
  // 0) 共享客户端（GitHub API / frontmatter 清洗）
  // ============================================================
  import { getFile } from '../../utils/gh-client';

  // ============================================================
  // 1) marked (markdown) + KaTeX (LaTeX) + DOMPurify (XSS 防护)
  //    全部走 ESM CDN，首次加载后被浏览器缓存
  // ============================================================
  const CDN = {
    marked: 'https://cdn.jsdelivr.net/npm/marked@13.0.3/+esm',
    katexCss: 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css',
    katexJs: 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.mjs',
    purify: 'https://cdn.jsdelivr.net/npm/dompurify@3.1.6/+esm',
  };

  function injectStyle(href: string) {
    return new Promise<void>((res) => {
      if (document.querySelector(`link[href="${href}"]`)) return res();
      const l = document.createElement('link');
      l.rel = 'stylesheet';
      l.href = href;
      l.onload = () => res();
      l.onerror = () => res();
      document.head.appendChild(l);
    });
  }

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function loadLibs() {
    const styleTask = injectStyle(CDN.katexCss);
    const [markedMod, purifyMod, katexMod] = await Promise.all([
      import(/* @vite-ignore */ CDN.marked),
      import(/* @vite-ignore */ CDN.purify),
      import(/* @vite-ignore */ CDN.katexJs),
    ]);
    await styleTask;

    // CDN ESM 构建的导出结构不一：兼容 namespace / named / default 三种形态
    const marked = markedMod?.parse
      ? markedMod
      : markedMod?.marked?.parse
        ? markedMod.marked
        : markedMod?.default?.parse
          ? markedMod.default
          : null;
    const DOMPurify = purifyMod?.sanitize
      ? purifyMod
      : purifyMod?.default?.sanitize
        ? purifyMod.default
        : null;
    const katex = katexMod?.renderToString
      ? katexMod
      : katexMod?.default?.renderToString
        ? katexMod.default
        : null;
    if (!marked?.parse) throw new Error('marked 加载异常');
    if (!DOMPurify?.sanitize) throw new Error('DOMPurify 加载异常');
    if (!katex?.renderToString) throw new Error('KaTeX 加载异常');
    (window as any).katex = katex;
    return { marked, DOMPurify };
  }

  // ============================================================
  // 2) 编辑器核心：textarea + 工具栏 + 实时预览
  // ============================================================
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const ta = $<HTMLTextAreaElement>('ed-textarea');
  const previewEl = $('ed-preview');
  const filenameEl = $<HTMLInputElement>('ed-filename');
  const statusEl = $('ed-status');
  const shell = document.querySelector<HTMLElement>('.editor-shell')!;
  const fileInput = $<HTMLInputElement>('ed-image-input');
  const videoInput = $<HTMLInputElement>('ed-video-input');
  const toast = $('ed-toast');

  // 原始文件名：URL 带 ?file= 时进入「编辑已有文章」模式
  const editFile = new URLSearchParams(location.search).get('file');

  let libs: Awaited<ReturnType<typeof loadLibs>> | null = null;
  let cacheKey = '';
  let cacheValue = '';

  function setStatus(state: 'dirty' | 'saved' | 'idle', text: string) {
    statusEl.classList.remove('dirty', 'saved');
    if (state === 'dirty') statusEl.classList.add('dirty');
    if (state === 'saved') statusEl.classList.add('saved');
    statusEl.textContent = text;
  }

  function showToast(msg: string, kind: 'success' | 'error' | 'info' = 'info') {
    toast.textContent = msg;
    toast.classList.remove('success', 'error');
    if (kind !== 'info') toast.classList.add(kind);
    toast.hidden = false;
    requestAnimationFrame(() => toast.classList.add('show'));
    clearTimeout((toast as any)._t);
    (toast as any)._t = setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => (toast.hidden = true), 250);
    }, 3200);
  }

  // 行内 / 块级 LaTeX 处理：用占位符保护，避免被 markdown 渲染吃掉
  function renderMath(text: string, katex: any, DOMPurify: any, marked: any) {
    const placeholders: string[] = [];

    function protectTex(tex: string, display: boolean): string {
      const i = placeholders.length;
      placeholders.push(
        display
          ? `<div class="math-block" data-math="${i}" data-display="1">${katex.renderToString(tex, { displayMode: true, throwOnError: false })}</div>`
          : `<span class="math-inline" data-math="${i}">${katex.renderToString(tex, { displayMode: false, throwOnError: false })}</span>`,
      );
      return `\u0000MATH${i}\u0000`;
    }

    // 块级 $$ … $$
    text = text.replace(/\$\$([\s\S]+?)\$\$/g, (_m, tex) => protectTex(tex.trim(), true));
    // 行内 $ … $（要求非空白边界）
    text = text.replace(/(^|[^\\$])\$([^\n$]+?)\$(?!\d)/g, (_m, pre, tex) => pre + protectTex(tex.trim(), false));

    // markdown → HTML
    let html = marked.parse(text, {
      gfm: true,
      breaks: true,
    }) as string;

    // 占位符还原
    html = html.replace(/\u0000MATH(\d+)\u0000/g, (_m, idx) => placeholders[Number(idx)]);

    return DOMPurify.sanitize(html, {
      ADD_TAGS: ['math', 'mtext', 'mrow', 'mi', 'mo', 'mn', 'msup', 'msub', 'mfrac', 'msqrt', 'mtable', 'mtr', 'mtd', 'video', 'source'],
      ADD_ATTR: ['data-math', 'data-display', 'style', 'class', 'controls', 'src', 'preload', 'type'],
    });
  }

  // frontmatter 单独渲染成元数据卡片，不进 markdown 正文
  function splitFrontmatter(text: string): { fm: string; body: string } {
    const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---\s*(?:\n|$)/);
    if (!m) return { fm: '', body: text };
    return { fm: m[1], body: text.slice(m[0].length) };
  }

  /**
   * 保存前清洗 frontmatter：把「冒号后留空」的字段整行删掉。
   * YAML 会把空值解析成 null，而站点 schema 虽已兼容 null，
   * 但删掉空行可以让 frontmatter 本身保持干净（也利于手读手改）。
   */
  function cleanFrontmatter(text: string): string {
    const m = text.match(/^---\r?\n([\s\S]*?)\r?\n---/);
    if (!m) return text;
    const cleanedFm = m[1]
      .split('\n')
      .filter((line) => !/^[A-Za-z_][\w-]*:\s*(#.*)?$/.test(line.trimEnd()))
      .join('\n');
    return `---\n${cleanedFm}\n---${text.slice(m[0].length)}`;
  }

  function renderFrontmatter(fm: string): string {
    if (!fm) return '';
    const rows = fm
      .split('\n')
      .map((line) => {
        const idx = line.indexOf(':');
        if (idx < 1) return `<div class="fm-row"><span class="fm-key">${line}</span></div>`;
        const key = line.slice(0, idx).trim();
        const val = line.slice(idx + 1).trim();
        return `<div class="fm-row"><span class="fm-key">${key}</span><span class="fm-val">${val}</span></div>`;
      })
      .join('');
    return `<div class="fm-card"><div class="fm-title">文章信息（frontmatter）</div>${rows}</div>`;
  }

  async function updatePreview() {
    if (!libs) return;
    const text = ta.value;
    if (text === cacheKey) return;
    cacheKey = text;
    const { marked, DOMPurify } = libs;
    const katex = (window as any).katex;
    try {
      const { fm, body } = splitFrontmatter(text);
      previewEl.innerHTML = renderFrontmatter(fm) + renderMath(body, katex, DOMPurify, marked);
    } catch (e) {
      previewEl.innerHTML = `<pre style="color:#b93a1a">渲染失败：${(e as Error).message}</pre>`;
    }
    if (text !== cacheValue) setStatus('dirty', '未保存');
  }

  // ============================================================
  // 3) 工具栏插入逻辑
  // ============================================================
  type Act =
    | 'h1' | 'h2' | 'h3' | 'bold' | 'italic' | 'strike' | 'code'
    | 'link' | 'image' | 'table' | 'math' | 'math-block' | 'task' | 'quote'
    | 'codeblock' | 'ul' | 'ol' | 'undo' | 'redo';

  function wrapSelection(before: string, after = before, placeholder = '') {
    const start = ta.selectionStart;
    const end = ta.selectionEnd;
    const sel = ta.value.slice(start, end) || placeholder;
    const next = ta.value.slice(0, start) + before + sel + after + ta.value.slice(end);
    ta.value = next;
    const cursor = start + before.length;
    ta.focus();
    ta.setSelectionRange(cursor, cursor + sel.length);
    updatePreview();
  }

  function insertAtLineStart(prefix: string) {
    const start = ta.selectionStart;
    const before = ta.value.slice(0, start);
    const lineStart = before.lastIndexOf('\n') + 1;
    ta.value = ta.value.slice(0, lineStart) + prefix + ta.value.slice(lineStart);
    ta.setSelectionRange(start + prefix.length, start + prefix.length);
    ta.focus();
    updatePreview();
  }

  function insertBlock(snippet: string) {
    const start = ta.selectionStart;
    const end = ta.selectionEnd;
    const lineStart = ta.value.lastIndexOf('\n', start - 1) + 1;
    const lineEnd = ta.value.indexOf('\n', end);
    const next = ta.value.slice(0, lineStart) + snippet + '\n' + ta.value.slice(lineEnd === -1 ? ta.value.length : lineEnd + 1);
    ta.value = next;
    ta.focus();
    updatePreview();
  }

  function act(a: Act) {
    switch (a) {
      case 'h1': insertAtLineStart('# '); break;
      case 'h2': insertAtLineStart('## '); break;
      case 'h3': insertAtLineStart('### '); break;
      case 'bold': wrapSelection('**', '**', '加粗'); break;
      case 'italic': wrapSelection('*', '*', '斜体'); break;
      case 'strike': wrapSelection('~~', '~~', '删除'); break;
      case 'code': wrapSelection('`', '`', 'code'); break;
      case 'link': {
        const url = prompt('链接 URL：', 'https://');
        if (!url) return;
        wrapSelection('[', `](${url})`, '链接文字');
        break;
      }
      case 'image': {
        fileInput.click();
        return;
      }
      case 'video': {
        videoInput.click();
        return;
      }
      case 'table': {
        insertBlock(
          [
            '| 列 1 | 列 2 | 列 3 |',
            '| ---- | ---- | ---- |',
            '| a    | b    | c    |',
            '| d    | e    | f    |',
          ].join('\n'),
        );
        break;
      }
      case 'math': wrapSelection('$', '$', 'a^2+b^2=c^2'); break;
      case 'math-block': {
        insertBlock(['$$\\', 'a^2 + b^2 = c^2', '$$'].join('\n'));
        break;
      }
      case 'task': insertBlock('- [x] 已完成\n- [ ] 待办'); break;
      case 'quote': insertAtLineStart('> '); break;
      case 'codeblock': {
        const lang = prompt('语言（可留空）：', 'ts') ?? '';
        insertBlock('```' + lang + '\n你的代码\n```');
        break;
      }
      case 'ul': insertAtLineStart('- '); break;
      case 'ol': insertAtLineStart('1. '); break;
      case 'undo': document.execCommand('undo'); break;
      case 'redo': document.execCommand('redo'); break;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.ed-toolbar button').forEach((b) => {
    b.addEventListener('click', (e) => {
      e.preventDefault();
      const a = b.dataset.act as Act | undefined;
      if (a) act(a);
    });
  });

  // ============================================================
  // 4) 拖拽 / 选择文件 → 上传到 GitHub → 按类型插入（图片/视频/文件链接）
  // ============================================================
  async function ghUploadBinary(file: File): Promise<string> {
    const cfg = readCfg();
    if (!cfg.token) {
      showToast('请先设置 GitHub Token（含 repo 权限）', 'error');
      openSettings();
      throw new Error('no token');
    }
    if (file.size > 90 * 1024 * 1024) {
      throw new Error('文件超过 90MB（GitHub 单文件上限 100MB），请先压缩');
    }
    const ext = (file.name.match(/\.([a-zA-Z0-9]+)$/)?.[1] ?? 'bin').toLowerCase();
    const safeName = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
    const path = `public/uploads/${safeName}`;

    // 大文件不能一次性展开为参数列表，按 32KB 分块转二进制字符串
    const bytes = new Uint8Array(await file.arrayBuffer());
    let bin = '';
    const CH = 0x8000;
    for (let i = 0; i < bytes.length; i += CH) {
      bin += String.fromCharCode(...bytes.subarray(i, i + CH));
    }
    showToast(`正在上传 ${file.name}…`);
    const res = await fetch(
      `https://api.github.com/repos/${cfg.repo}/contents/${path}`,
      {
        method: 'PUT',
        headers: {
          Authorization: `Bearer ${cfg.token}`,
          Accept: 'application/vnd.github+json',
          'X-GitHub-Api-Version': '2022-11-28',
        },
        body: JSON.stringify({ message: `upload: ${safeName}`, branch: cfg.branch, content: btoa(bin) }),
      },
    );
    if (!res.ok) {
      const txt = await res.text();
      throw new Error(`上传失败 HTTP ${res.status} · ${txt.slice(0, 120)}`);
    }
    return `https://raw.githubusercontent.com/${cfg.repo}/${cfg.branch}/${path}`;
  }

  function insertText(text: string) {
    const s = ta.selectionStart;
    ta.value = ta.value.slice(0, s) + text + ta.value.slice(ta.selectionEnd);
    ta.setSelectionRange(s + text.length, s + text.length);
    ta.focus();
    updatePreview();
  }

  function snippetFor(file: File, url: string): string {
    if (file.type.startsWith('image/')) {
      return `\n\n![${file.name.replace(/\.[^.]+$/, '')}](${url})\n\n`;
    }
    if (file.type.startsWith('video/')) {
      return `\n\n<video controls preload="metadata" src="${url}"></video>\n\n`;
    }
    return `\n\n[${file.name}](${url})\n\n`;
  }

  async function handleFiles(files: File[]) {
    let done = 0;
    for (const f of files) {
      try {
        const url = await ghUploadBinary(f);
        insertText(snippetFor(f, url));
        done++;
      } catch (e) {
        showToast((e as Error).message, 'error');
      }
    }
    if (done) showToast(`已插入 ${done} 个文件 ✓`, 'success');
  }

  fileInput.addEventListener('change', () => {
    const f = fileInput.files?.[0];
    if (f) handleFiles([f]);
    fileInput.value = '';
  });
  videoInput.addEventListener('change', () => {
    const f = videoInput.files?.[0];
    if (f) handleFiles([f]);
    videoInput.value = '';
  });

  // 拖拽：图片、视频、其他附件都支持
  let dragCount = 0;
  window.addEventListener('dragenter', (e) => {
    if (!e.dataTransfer?.types.includes('Files')) return;
    dragCount++;
    shell.classList.add('drop-active');
  });
  window.addEventListener('dragleave', () => {
    dragCount = Math.max(0, dragCount - 1);
    if (!dragCount) shell.classList.remove('drop-active');
  });
  window.addEventListener('dragover', (e) => {
    if (e.dataTransfer?.types.includes('Files')) e.preventDefault();
  });
  window.addEventListener('drop', (e) => {
    if (!e.dataTransfer?.files?.length) return;
    e.preventDefault();
    dragCount = 0;
    shell.classList.remove('drop-active');
    handleFiles(Array.from(e.dataTransfer.files));
  });

  // ============================================================
  // 5) 保存到 GitHub（PUT /contents API）
  // ============================================================
  interface Cfg { repo: string; branch: string; token: string }
  function readCfg(): Cfg {
    return {
      repo: localStorage.getItem('ed_repo') || '',
      branch: localStorage.getItem('ed_branch') || 'main',
      token: localStorage.getItem('ed_token') || '',
    };
  }

  async function saveToGitHub() {
    const cfg = readCfg();
    if (!cfg.token) {
      showToast('需要先设置 GitHub Token', 'error');
      openSettings();
      return;
    }
    // title 是唯一必填字段：空着会让 CI 构建失败
    const fmMatch = ta.value.match(/^---\r?\n([\s\S]*?)\r?\n---/);
    const titleVal = fmMatch?.[1].match(/^title:\s*(.+)$/m)?.[1]?.trim();
    if (!titleVal) {
      showToast('frontmatter 里的 title 还没填（必填）', 'error');
      return;
    }
    let filename = filenameEl.value.trim();
    if (!filename) {
      showToast('文件名不能为空', 'error');
      return;
    }
    if (!filename.endsWith('.md')) filename += '.md';
    if (!/^[\w\-./]+\.md$/.test(filename)) {
      showToast('文件名只允许字母/数字/中划线/下划线/点和 /', 'error');
      return;
    }

    const saveBtn = $('ed-save') as HTMLButtonElement;
    saveBtn.disabled = true;
    saveBtn.textContent = '正在提交…';

    try {
      const path = `src/content/posts/${filename}`;
      // 检查是否已存在（获取 sha 才能更新）
      const head = await fetch(
        `https://api.github.com/repos/${cfg.repo}/contents/${path}?ref=${cfg.branch}`,
        { headers: { Authorization: `Bearer ${cfg.token}`, Accept: 'application/vnd.github+json' } },
      );
      let existingSha: string | undefined;
      if (head.ok) {
        const j = await head.json();
        existingSha = j.sha;
      }

      const b64 = btoa(unescape(encodeURIComponent(cleanFrontmatter(ta.value))));
      const body: any = {
        message: existingSha ? `post: revise ${filename}` : `post: new ${filename}`,
        branch: cfg.branch,
        content: b64,
      };
      if (existingSha) body.sha = existingSha;

      const res = await fetch(
        `https://api.github.com/repos/${cfg.repo}/contents/${path}`,
        {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${cfg.token}`,
            'Accept': 'application/vnd.github+json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(body),
        },
      );
      if (!res.ok) {
        const t = await res.text();
        throw new Error(`HTTP ${res.status} · ${t.slice(0, 140)}`);
      }
      const j = await res.json();
      const htmlUrl = j.content?.html_url ?? `https://github.com/${cfg.repo}/blob/${cfg.branch}/${path}`;
      setStatus('saved', '已保存 ✓');
      cacheValue = ta.value;
      showToast('已提交到 GitHub，等 CI 部署…', 'success');
      setTimeout(() => {
        if (confirm('提交成功！打开 GitHub 文件页面？')) {
          window.open(htmlUrl, '_blank');
        }
      }, 600);
    } catch (e) {
      showToast(`保存失败：${(e as Error).message}`, 'error');
    } finally {
      saveBtn.disabled = false;
      saveBtn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4.5 12.5 5 5L19.5 7"></path></svg> 保存到 GitHub';
    }
  }

  $('ed-save').addEventListener('click', saveToGitHub);
  $('ed-toggle').addEventListener('click', () => {
    shell.classList.toggle('preview-only');
    shell.classList.remove('edit-only');
  });

  // ============================================================
  // 6) 设置弹窗（GitHub 凭据）
  // ============================================================
  const dlg = $<HTMLDialogElement>('ed-settings-dlg');
  function openSettings() {
    const cfg = readCfg();
    $('ed-repo').value = cfg.repo || $('ed-repo').defaultValue;
    $('ed-branch').value = cfg.branch || 'main';
    $('ed-token').value = cfg.token;
    dlg.showModal();
  }
  function closeSettings() {
    dlg.close();
  }
  $('ed-settings').addEventListener('click', openSettings);
  dlg.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-close]') || e.target === dlg) closeSettings();
  });
  $('ed-save-token').addEventListener('click', () => {
    const repo = $('ed-repo').value.trim();
    const branch = $('ed-branch').value.trim() || 'main';
    const token = $('ed-token').value.trim();
    if (!repo || !token) {
      showToast('仓库和 Token 都要填', 'error');
      return;
    }
    localStorage.setItem('ed_repo', repo);
    localStorage.setItem('ed_branch', branch);
    localStorage.setItem('ed_token', token);
    closeSettings();
    showToast('凭据已保存到本机浏览器 ✓', 'success');
  });

  // ============================================================
  // 6.5) 外观调节（主题 / 字号 / 字体），localStorage 持久化
  // ============================================================
  const pop = $('ed-appearance-pop');
  const appearanceKeys: Record<string, string> = {
    theme: 'ed_theme',
    size: 'ed_fontsize',
    font: 'ed_font',
  };
  const appearanceDefaults: Record<string, string> = { theme: 'dark', size: 'm', font: 'sans' };

  function applyAppearance() {
    const vals: Record<string, string> = {};
    for (const [key, lsKey] of Object.entries(appearanceKeys)) {
      const v = localStorage.getItem(lsKey) || appearanceDefaults[key];
      vals[key] = v;
    }
    shell.dataset.edTheme = vals.theme;
    shell.dataset.edSize = vals.size;
    shell.dataset.edFont = vals.font;
    // 同步按钮高亮
    pop.querySelectorAll<HTMLButtonElement>('.ed-opt').forEach((b) => {
      b.classList.toggle('active', vals[b.dataset.set!] === b.dataset.val);
    });
    return vals;
  }

  function togglePop(force?: boolean) {
    const show = force ?? pop.hidden;
    pop.hidden = !show;
  }

  $('ed-appearance').addEventListener('click', (e) => {
    e.stopPropagation();
    togglePop();
  });

  pop.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ed-opt');
    if (!btn) return;
    const key = btn.dataset.set!;
    localStorage.setItem(appearanceKeys[key], btn.dataset.val!);
    applyAppearance();
  });

  // 点击弹层外关闭
  document.addEventListener('click', (e) => {
    if (pop.hidden) return;
    if (!(e.target as HTMLElement).closest('#ed-appearance-pop, #ed-appearance')) {
      pop.hidden = true;
    }
  });

  // Escape 关闭
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !pop.hidden) pop.hidden = true;
  });

  applyAppearance();

  // ============================================================
  // 7) 监听输入 & 快捷键
  // ============================================================
  ta.addEventListener('input', () => {
    if (ta.value !== cacheValue) {
      cacheValue = ta.value;
      setStatus('dirty', '未保存');
    }
    updatePreview();
  });

  ta.addEventListener('keydown', (e) => {
    const meta = e.metaKey || e.ctrlKey;
    if (!meta) return;
    if (e.key.toLowerCase() === 's') {
      e.preventDefault();
      saveToGitHub();
    } else if (e.key.toLowerCase() === 'b') {
      e.preventDefault();
      act('bold');
    } else if (e.key.toLowerCase() === 'i') {
      e.preventDefault();
      act('italic');
    } else if (e.key.toLowerCase() === 'k') {
      e.preventDefault();
      act('link');
    }
  });

  // tab 插入两个空格
  ta.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      e.preventDefault();
      const s = ta.selectionStart, en = ta.selectionEnd;
      ta.value = ta.value.slice(0, s) + '  ' + ta.value.slice(en);
      ta.setSelectionRange(s + 2, s + 2);
      updatePreview();
    }
  });

  // 防止误关浏览器
  window.addEventListener('beforeunload', (e) => {
    if (statusEl.classList.contains('dirty')) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  // ============================================================
  // 启动：先就绪库，再按需加载已有文章（?file=xxx.md 模式）
  // ============================================================
  if (editFile) {
    ($('ed-save') as HTMLButtonElement).textContent = '更新到 GitHub';
  }

  (async () => {
    try {
      setStatus('idle', '初始化…');
      if (editFile) {
        try {
          const { content } = await getFile(`src/content/posts/${editFile}`);
          ta.value = content;
          filenameEl.value = editFile;
          cacheValue = ta.value;
          setStatus('idle', '已加载');
        } catch (e) {
          showToast(`加载 ${editFile} 失败：${(e as Error).message}`, 'error');
          cacheValue = ta.value;
          setStatus('idle', '新文章');
        }
      } else {
        cacheValue = ta.value;
        setStatus('idle', '就绪');
      }
      libs = await loadLibs();
      await updatePreview();
    } catch (e) {
      previewEl.innerHTML = `<pre style="color:#b93a1a">编辑器库加载失败：${(e as Error).message}\n请检查网络。</pre>`;
    }
  })();
</script>
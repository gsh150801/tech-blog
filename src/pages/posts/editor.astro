    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    font-size: 0.86rem;
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.4);
    z-index: 60;
    opacity: 0;
    transition: opacity 0.25s, transform 0.25s var(--ease-spring);

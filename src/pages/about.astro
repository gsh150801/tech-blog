---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Giscus from '../components/Giscus.astro';
import Seal from '../components/Seal.astro';
import { SITE } from '../config';
import { withBase } from '../utils/path';

const socials = [
  SITE.social.github && {
    href: SITE.social.github,
    icon: 'github',
    name: 'GitHub',
    desc: '代码与项目',
  },
  SITE.social.xiaohongshu && {
    href: SITE.social.xiaohongshu,
    icon: 'xiaohongshu',
    name: '小红书',
    desc: SITE.social.xiaohongshu,
  },
  SITE.social.email && {
    href: `mailto:${SITE.social.email}`,
    icon: 'mail',
    name: '邮箱',
    desc: SITE.social.email,
  },
  SITE.social.rss && {
    href: withBase('/rss.xml'),
    icon: 'rss',
    name: 'RSS 订阅',
    desc: '用阅读器订阅本站',
  },
].filter(Boolean);

const columns = [
  {
    icon: 'pen',
    title: '教程笔记',
    text: '学到的技术写成教程，力求讲明白「为什么」，而不只是「怎么做」。代码块支持一键复制，方便跟着敲。',
  },
  {
    icon: 'sparkle',
    title: '小作文',
    text: '偶尔写点生活随笔。技术之外，也给自己留一方记录心事的纸。',
  },
  {
    icon: 'folder',
    title: '合集',
    text: '系列文章装订成卷，每卷一个独立链接，分享时一次带走整个主题。',
  },
];
---

<Base title="关于" description={`关于 ${SITE.title} 与 ${SITE.author}：这个博客写什么，以及在哪里能找到我。`}>
  <div class="container">
    <header class="page-head reveal">
      <h1 class="page-title">关于拾集</h1>
      <p class="page-desc">关于这个博客，和博客后面的人。</p>
    </header>

    <section class="me-card reveal">
      <img
        class="avatar"
        src="https://github.com/gsh150801.png"
        alt={`${SITE.author} 的头像`}
        width="88"
        height="88"
        loading="lazy"
        decoding="async"
      />
      <div class="me-info">
        <h2 class="me-name">{SITE.author}</h2>
        <p class="me-bio">
          深圳 · 程序员。写代码，也写字。这里是我的数字院子 ——
          拾技术之美，集生活之思。
        </p>
        <div class="me-links">
          <a class="chip" href={SITE.social.github} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={14} /> GitHub
          </a>
          <a class="chip" href={withBase('/rss.xml')}>
            <Icon name="rss" size={14} /> RSS
          </a>
        </div>
      </div>
      <Seal size={64} class="me-seal" />
    </section>

    <section class="what reveal">
      {
        columns.map((c) => (
          <article class="w-card">
            <span class="w-icon">
              <Icon name={c.icon as any} size={20} />
            </span>
            <h3 class="w-title">{c.title}</h3>
            <p class="w-text">{c.text}</p>
          </article>
        ))
      }
    </section>

    <section class="find reveal">
      <h2 class="find-title">在哪里找到我</h2>
      <div class="find-grid">
        {
          socials.map((s: any) => (
            <a class="f-card" href={s.href} target="_blank" rel="noopener noreferrer">
              <span class="f-icon">
                <Icon name={s.icon} size={22} />
              </span>
              <span class="f-name">{s.name}</span>
              <span class="f-desc">{s.desc}</span>
              <span class="f-arrow">
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          ))
        }
      </div>
      <p class="find-note">
        * 小红书、邮箱等链接在 <code>src/config.ts</code> 中配置，填上你的主页链接即可显示。
      </p>
    </section>

    <div class="guestbook">
      <Giscus />
    </div>
  </div>
</Base>

<style>
  .page-head {
    padding: 3.2rem 0 2.2rem;
  }

  .page-title {
    font-size: clamp(1.9rem, 4.5vw, 2.6rem);
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .page-title::before {
    content: '';
    width: 1.3rem;
    height: 0.6rem;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--accent), var(--gold));
    transform: skewX(-12deg);
  }

  .page-desc {
    margin: 0.7rem 0 0;
    color: var(--ink3);
    font-size: 0.92rem;
  }

  .me-card {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding: 1.8rem 2rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background:
      radial-gradient(90% 130% at 0% 0%, var(--wash) 0%, transparent 52%),
      var(--bg1);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .avatar {
    flex: none;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 50%;
    border: 3px solid var(--bg1);
    box-shadow: var(--shadow-md), 0 0 0 1.5px var(--line2);
  }

  .me-name {
    font-size: 1.5rem;
    margin: 0;
  }

  .me-bio {
    margin: 0.5rem 0 0.9rem;
    color: var(--ink2);
    font-size: 0.95rem;
    max-width: 34rem;
    line-height: 1.85;
  }

  .me-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .me-seal {
    position: absolute;
    right: 1.6rem;
    bottom: -0.8rem;
    opacity: 0.14;
    transform: rotate(-12deg);
    pointer-events: none;
  }

  .what {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .w-card {
    padding: 1.5rem 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg1);
    transition: transform 0.3s var(--ease-spring), box-shadow 0.3s, border-color 0.3s;
  }

  .w-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--line2);
  }

  .w-icon {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 10px;
    background: var(--wash);
    color: var(--accent-ink);
    margin-bottom: 0.9rem;
  }

  .w-title {
    font-size: 1.08rem;
    margin: 0 0 0.4rem;
  }

  .w-text {
    margin: 0;
    font-size: 0.87rem;
    color: var(--ink2);
    line-height: 1.8;
  }

  .find {
    margin-top: 3.2rem;
  }

  .find-title {
    font-size: 1.35rem;
    margin-bottom: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .find-title::before {
    content: '';
    width: 1.15rem;
    height: 0.55rem;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--accent), var(--gold));
    transform: skewX(-12deg);
  }

  .find-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1rem;
  }

  .f-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.9rem;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg1);
    transition: transform 0.3s var(--ease-spring), border-color 0.3s, box-shadow 0.3s;
  }

  .f-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line2));
    box-shadow: var(--shadow-md);
  }

  .f-icon {
    grid-row: 1 / 3;
    display: inline-grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 12px;
    background: var(--wash);
  }

  .f-name {
    font-weight: 640;
    font-size: 0.98rem;
  }

  .f-desc {
    font-size: 0.74rem;
    color: var(--ink3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 12rem;
  }

  .f-arrow {
    grid-row: 1 / 3;
    color: var(--ink3);
    transition: transform 0.25s var(--ease-out), color 0.25s;
  }

  .f-card:hover .f-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .find-note {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--ink3);
  }

  .find-note code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--wash);
    padding: 0.1em 0.4em;
    border-radius: 5px;
  }

  .guestbook {
    margin-top: 2.5rem;
  }

  @media (max-width: 560px) {
    .me-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
